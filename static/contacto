    <!-- FORM LOGIC -->
    <script>
        /* ==========================================================
           PASO ÚNICO DE CONFIGURACIÓN
           Pega aquí la URL del Web App de Google Apps Script.
           Se ve así:
           https://script.google.com/macros/s/AKfycbxxxxxxxxxxxxxxxx/exec
           ========================================================== */
        const ENDPOINT = 'PEGA_AQUI_LA_URL_DEL_APPS_SCRIPT';

        const form       = document.getElementById('contact-form');
        const statusEl   = document.getElementById('form-status');
        const submitBtn  = document.getElementById('submit-btn');
        const mensajeEl  = document.getElementById('mensaje');
        const charCount  = document.getElementById('char-count');
        const loadedAt   = Date.now();       // timing check against bots
        let   sending    = false;

        // Live character counter
        mensajeEl.addEventListener('input', () => {
            charCount.textContent = String(mensajeEl.value.length);
        });

        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        }

        // Status messages use textContent only — user input is never rendered as HTML.
        function setStatus(text, kind) {
            statusEl.textContent = text;
            statusEl.classList.remove('hidden', 'text-emerald-400', 'text-red-400', 'text-gray-300');
            statusEl.classList.add(
                kind === 'ok'    ? 'text-emerald-400' :
                kind === 'error' ? 'text-red-400' : 'text-gray-300'
            );
        }

        // Strip control characters and clamp length before sending.
        function clean(value, max) {
            return String(value == null ? '' : value)
                .replace(/[\u0000-\u001F\u007F]/g, ' ')
                .replace(/\s+/g, ' ')
                .trim()
                .slice(0, max);
        }

        function validate(payload) {
            if (payload.nombre.length < 2)    return 'Escribe tu nombre completo.';
            if (!/^[0-9+()\s-]{8,25}$/.test(payload.whatsapp)) return 'Escribe un número de WhatsApp válido.';
            if (!/\d{8,}/.test(payload.whatsapp.replace(/\D/g, ''))) return 'El WhatsApp debe tener al menos 8 dígitos.';
            if (!payload.motivo)              return 'Selecciona un motivo de contacto.';
            if (payload.mensaje.length < 10)  return 'Cuéntanos un poco más en el mensaje.';
            if (!document.getElementById('privacidad').checked) return 'Debes aceptar el Aviso de Privacidad.';
            return null;
        }

        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (sending) return;

            if (ENDPOINT === 'PEGA_AQUI_LA_URL_DEL_APPS_SCRIPT') {
                setStatus('El formulario aún no está conectado. Escríbenos por WhatsApp mientras tanto.', 'error');
                return;
            }

            // Bot traps: honeypot filled, or submitted impossibly fast.
            if (document.getElementById('website').value !== '' || (Date.now() - loadedAt) < 3000) {
                setStatus('No pudimos procesar el envío. Intenta de nuevo.', 'error');
                return;
            }

            const payload = {
                nombre:   clean(form.nombre.value, 100),
                whatsapp: clean(form.whatsapp.value, 25),
                motivo:   clean(form.motivo.value, 60),
                colegio:  clean(form.colegio.value, 80),
                mensaje:  clean(form.mensaje.value, 2000),
                origen:   'zarem.mx/contacto'
            };

            const problem = validate(payload);
            if (problem) { setStatus(problem, 'error'); return; }

            sending = true;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Enviando…';
            setStatus('Enviando tu mensaje…', 'info');

            try {
                // text/plain avoids a CORS preflight that Apps Script cannot answer.
                const response = await fetch(ENDPOINT, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();

                if (result && result.ok) {
                    form.reset();
                    charCount.textContent = '0';
                    setStatus('¡Gracias! Recibimos tu mensaje y te contactaremos por WhatsApp.', 'ok');
                } else {
                    setStatus('No pudimos registrar tu mensaje. Escríbenos por WhatsApp, por favor.', 'error');
                }
            } catch (err) {
                setStatus('Hubo un problema de conexión. Escríbenos por WhatsApp, por favor.', 'error');
            } finally {
                sending = false;
                submitBtn.disabled = false;
                submitBtn.textContent = 'Enviar mensaje';
            }
        });
    </script>
