    <!-- JAVASCRIPT APP LOGIC -->
    <script>
        // State variables
        let selectedCategory = 'all';
        let cart = [];
        // DOM elements
        const searchInput = document.getElementById('search-input');
        const sizeFilter = document.getElementById('size-filter');
        const sortSelect = document.getElementById('sort-select');
        const productsGrid = document.getElementById('products-grid');
        const productCards = Array.from(document.querySelectorAll('.product-card'));
        const visibleCountSpan = document.getElementById('visible-count');
        const noResultsDiv = document.getElementById('no-results');
        // Category Filter Function
        function setCategoryFilter(category, buttonEl) {
            selectedCategory = category;
            // Update button styles
            const buttons = document.querySelectorAll('#category-pills button');
            buttons.forEach(btn => btn.classList.remove('active', 'text-brand-dark', 'bg-white'));
            buttons.forEach(btn => btn.classList.add('text-gray-300'));
            buttonEl.classList.add('active');
            buttonEl.classList.remove('text-gray-300');
            applyFilters();
        }
        // Apply All Active Filters (Category, Search, Size & Sort)
        function applyFilters() {
            const query = searchInput.value.trim().toLowerCase();
            const selectedSize = sizeFilter.value;
            const sortMode = sortSelect.value;
            let visibleCount = 0;
            // Filter logic
            productCards.forEach(card => {
                const name = card.dataset.name.toLowerCase();
                const categories = card.dataset.categories.split(' ');
                const sizes = card.dataset.sizes.split(',');
                const matchesCategory = selectedCategory === 'all' || categories.includes(selectedCategory);
                const matchesSearch = name.includes(query);
                const matchesSize = selectedSize === 'all' || sizes.includes(selectedSize);
                if (matchesCategory && matchesSearch && matchesSize) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });
            // Update visible stats
            visibleCountSpan.textContent = visibleCount;
            if (visibleCount === 0) {
                noResultsDiv.classList.remove('hidden');
            } else {
                noResultsDiv.classList.add('hidden');
            }
            // Sort logic
            if (sortMode !== 'default') {
                const visibleCards = productCards.filter(card => !card.classList.contains('hidden'));
                visibleCards.sort((a, b) => {
                    const priceA = parseFloat(a.dataset.price);
                    const priceB = parseFloat(b.dataset.price);
                    const nameA = a.dataset.name;
                    const nameB = b.dataset.name;
                    if (sortMode === 'price-asc') return priceA - priceB;
                    if (sortMode === 'price-desc') return priceB - priceA;
                    if (sortMode === 'name-asc') return nameA.localeCompare(nameB);
                    return 0;
                });
                visibleCards.forEach(card => productsGrid.appendChild(card));
            }
        }
        // Reset Filters
        function resetFilters() {
            searchInput.value = '';
            sizeFilter.value = 'all';
            sortSelect.value = 'default';
            const allBtn = document.querySelector('#category-pills button');
            setCategoryFilter('all', allBtn);
        }
        // CART LOGIC
        function toggleCartDrawer() {
            const drawer = document.getElementById('cart-drawer');
            drawer.classList.toggle('hidden');
        }
        function addToCart(id, name, price) {
            const existing = cart.find(item => item.id === id);
            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({ id, name, price, quantity: 1 });
            }
            updateCartUI();
            showToast(`"${name}" agregada a tu carrito.`);
        }
        function removeFromCart(id) {
            cart = cart.filter(item => item.id !== id);
            updateCartUI();
        }
        function changeQuantity(id, delta) {
            const item = cart.find(i => i.id === id);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) removeFromCart(id);
                else updateCartUI();
            }
        }
        function updateCartUI() {
            const badge = document.getElementById('cart-badge-count');
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            badge.textContent = totalItems;
            const container = document.getElementById('cart-items-container');
            const emptyMsg = document.getElementById('cart-empty-message');
            const totalPriceSpan = document.getElementById('cart-total-price');
            if (cart.length === 0) {
                container.innerHTML = '';
                container.appendChild(emptyMsg);
                emptyMsg.classList.remove('hidden');
                totalPriceSpan.textContent = '$0.00 MXN';
                return;
            }
            emptyMsg.classList.add('hidden');
            let html = '';
            let total = 0;
            cart.forEach(item => {
                const subtotal = item.price * item.quantity;
                total += subtotal;
                html += `
                    <div class="flex items-center justify-between bg-brand/60 p-3.5 rounded-xl border border-white/10">
                        <div class="flex-1 pr-3">
                            <h4 class="font-medium text-sm text-white">${item.name}</h4>
                            <span class="text-xs text-brand-gold">$${item.price}.00 MXN</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="changeQuantity('${item.id}', -1)" class="w-6 h-6 rounded bg-white/10 text-white flex items-center justify-center hover:bg-white/20">-</button>
                            <span class="text-xs font-bold text-white px-1">${item.quantity}</span>
                            <button onclick="changeQuantity('${item.id}', 1)" class="w-6 h-6 rounded bg-white/10 text-white flex items-center justify-center hover:bg-white/20">+</button>
                            <button onclick="removeFromCart('${item.id}')" class="ml-2 text-red-400 hover:text-red-300">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
            totalPriceSpan.textContent = `$${total.toFixed(2)} MXN`;
        }
        function showToast(msg) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toast-message');
            toastMessage.textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
        function checkout() {
            if (cart.length === 0) {
                showToast("Tu carrito está vacío.");
                return;
            }
            showToast("Redirigiendo a la plataforma de pago seguro...");
        }
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }
    </script>
